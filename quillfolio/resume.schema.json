{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/quillfolio/resume.schema.json",
  "title": "Quillfolio resume",
  "description": "A resume file edited locally by the person running Quillfolio.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "headline": {"type": "string", "minLength": 1},
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "phone": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "website": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "tailored_for": {"type": "string", "minLength": 1}
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["company", "title", "start"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "company": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "start": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
          "end": {
            "type": "string",
            "pattern": "^(present|\\d{4}(-\\d{2}(-\\d{2})?)?)$"
          },
          "skills": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "highlights": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "skills": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "highlights": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["school", "degree"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "school": {"type": "string", "minLength": 1},
          "degree": {"type": "string", "minLength": 1},
          "start": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
          "end": {
            "type": "string",
            "pattern": "^(present|\\d{4}(-\\d{2}(-\\d{2})?)?)$"
          },
          "details": {"type": "string", "minLength": 1}
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "items"],
        "properties": {
          "group": {"type": "string", "minLength": 1},
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
